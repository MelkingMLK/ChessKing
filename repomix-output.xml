<file path="Models/ChessSquare.cs">
using CommunityToolkit.Mvvm.ComponentModel;

namespace ChessStrategyApp.Models;

public partial class ChessSquare : ObservableObject
{
    public int Row { get; }
    public int Column { get; }
    public bool IsDark => (Row + Column) % 2 != 0;
    public string BackgroundBrush => IsDark ? "#000000" : "#FFFFFF";
    
    [ObservableProperty]
    [NotifyPropertyChangedFor(nameof(PieceGlyph))]
    private string _piece = string.Empty;       

    [ObservableProperty]
    [NotifyPropertyChangedFor(nameof(PieceGlyph))]
    [NotifyPropertyChangedFor(nameof(PieceForeground))]
    private string _pieceColor = string.Empty;  

    public string PieceGlyph => Piece switch
    {
        "K" => PieceColor == "White" ? "♔" : "♚",
        "Q" => PieceColor == "White" ? "♕" : "♛",
        "R" => PieceColor == "White" ? "♖" : "♜",
        "B" => PieceColor == "White" ? "♗" : "♝",
        "N" => PieceColor == "White" ? "♘" : "♞", // Corretto: cavallo bianco
        "P" => PieceColor == "White" ? "♙" : "♟",
        _ => string.Empty
    };

    public string PieceForeground => PieceColor == "White" ? "#AB8476" : "#8675A9";

    public ChessSquare(int row, int col, string piece = "", string pieceColor = "")
    {
        Row = row;
        Column = col;
        _piece = piece;
        _pieceColor = pieceColor;
    }
}
</file>

<file path="Models/MatchHistoryItem.cs">
using System;
using System.Collections.Generic;

namespace ChessStrategyApp.Models;

public class MatchHistoryItem
{
    public Guid Id { get; set; } = Guid.NewGuid();
    public DateTime PlayedAt { get; set; } = DateTime.Now;
    
    public string WhitePlayer { get; set; } = string.Empty;
    public string BlackPlayer { get; set; } = string.Empty;
    public string WinnerPlayer { get; set; } = string.Empty; // "Draw" se patta
    public string TerminationReason { get; set; } = string.Empty; // "Checkmate", "Timeout", "Resignation", "Draw"
    
    public string WhiteTimeLeft { get; set; } = string.Empty;
    public string BlackTimeLeft { get; set; } = string.Empty;
    public TimeSpan MatchDuration { get; set; }

    public string FinalFen { get; set; } = string.Empty;
    public List<string> MoveHistory { get; set; } = new();

    // Proprietà computate per la UI
    public string CardTitle => $"{WhitePlayer} vs {BlackPlayer}";
    public string FormattedDate => PlayedAt.ToString("dd/MM/yyyy HH:mm");
    public string ResultSummary => WinnerPlayer == "Draw" 
        ? "Patta" 
        : $"Vince: {WinnerPlayer} ({TerminationReason})";
}
</file>

